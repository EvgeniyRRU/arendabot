ARENDABOT_BOT_TOKEN=123456:replace_with_your_bot_token_from_BotFather
ARENDABOT_DATABASE_URL=postgresql+asyncpg://arendabot:arendabot@postgres:5432/arendabot
ARENDABOT_UPDATE_MODE=polling
ARENDABOT_DATABASE_ECHO=false
ARENDABOT_DROP_PENDING_UPDATES=false
ARENDABOT_LOG_LEVEL=INFO

# Required only when ARENDABOT_UPDATE_MODE=webhook:
# ARENDABOT_WEBHOOK_BASE_URL=https://bot.example.com
# ARENDABOT_WEBHOOK_SECRET=replace_with_a_random_secret

